# Copy to .env and fill in. Never commit .env.

# Required. A key just for this app, with a monthly spend limit set in the Anthropic Console.
ANTHROPIC_API_KEY=

# The domain pointed at this server (an A record to its IP). Caddy gets the HTTPS certificate.
DOMAIN=cre.example.com

# Login for the app. Make the hash with:
#   docker run --rm caddy:2.8 caddy hash-password --plaintext 'your-password'
# Keep the single quotes around the hash — it contains $ signs.
APP_USER=don
APP_PASSWORD_HASH='$2a$14$replace-with-the-output-of-hash-password'

# Optional
# CLAUDE_MODEL=claude-sonnet-5-5
# MAX_UPLOAD_MB=100
# MAX_CONCURRENT_ANALYSES=3
# LANGSMITH_API_KEY=
